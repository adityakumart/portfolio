{
  "name": "portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev:web": "npx nx serve portfolio --hmr -o",
    "build": "nx build portfolio --configuration production && gzipper compress ./dist/apps/portfolio",
    "githubBuild": "nx build portfolio --configuration production && npx angular-cli-ghpages --dir=dist/apps/portfolio/browser",
    "build1": "nx build portfolio --configuration production --source-map && gzipper compress ./dist/apps/portfolio",
    "watch": "nx build portfolio --watch --configuration development",
    "test": "nx test portfolio",
    "serve:ssr:portfolio": "node dist/apps/portfolio/server/server.mjs",
    "dev:api": "npx nx serve portfolio-core",
    "vercel:preview": "npx vercel --cwd apps/portfolio-core",
    "vercel:production": "npx vercel --cwd apps/portfolio-core --prod",
    "vercel:web:preview": "npx vercel",
    "vercel:web:production": "npx vercel --prod",
    "build:vercel": "nx build portfolio --configuration production --base-href /"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-browser-dynamic": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@types/crypto-js": "^4.2.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "crypto-ts": "^1.0.2",
    "css-fx-layout": "^3.0.4",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.5.0",
    "mongodb": "^7.5.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~22.0.0",
    "@angular-devkit/schematics": "~22.0.0",
    "@angular/build": "^22.0.0",
    "@angular/cli": "~22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.7.5",
    "@nx/esbuild": "22.7.5",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/vitest": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@schematics/angular": "~22.0.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.4.2",
    "@types/node": "^20.19.9",
    "@types/qrcode": "^1.5.6",
