      ],
      "@spartan-ng/hel/tabs": [
        "./libs/styles/tabs/src/index.ts"
      ],
      "@spartan-ng/hel/spinner": [
        "./libs/styles/spinner/src/index.ts"
      ],
      "@spartan-ng/hel/progress": [
        "./libs/styles/progress/src/index.ts"
      ],
      "@spartan-ng/hel/radio-group": [
        "./libs/styles/radio-group/src/index.ts"
