{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "@portfolio/shared-types": [
        "./libs/shared-types/src/index.ts"
      ],
      "@spartan-ng/hel/button": [
        "./libs/styles/button/src/index.ts"
      ],
      "@spartan-ng/hel/utils": [
        "./libs/styles/utils/src/index.ts"
      ],
      "@spartan-ng/hel/tooltip": [
        "./libs/styles/tooltip/src/index.ts"
      ],
      "@spartan-ng/hel/dropdown-menu": [
        "./libs/styles/dropdown-menu/src/index.ts"
      ],
      "@spartan-ng/hel/card": [
        "./libs/styles/card/src/index.ts"
      ],
      "@spartan-ng/hel/badge": [
        "./libs/styles/badge/src/index.ts"
      ],
      "@spartan-ng/hel/separator": [
        "./libs/styles/separator/src/index.ts"
      ]
    },
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "useDefineForClassFields": false,
    "rootDir": "."
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
