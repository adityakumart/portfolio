{
  "manifest_version": 3,
  "name": "RR Fleet Management",
  "version": "1.0.0",
  "description": "Quick access to RR fleet bookings, vehicles, and stats.",
  "action": {
    "default_popup": "index.html",
    "default_title": "Open RR Management"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ]
}
