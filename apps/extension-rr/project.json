{
  "name": "extension-rr",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/extension-rr/src",
  "tags": [],
  "targets": {
    "set-env": {
      "command": "node tools/scripts/set-env.js"
    },
    "build": {
      "executor": "@angular/build:application",
      "dependsOn": ["set-env"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/extension-rr",
        "baseHref": "./",
        "browser": "apps/extension-rr/src/main.ts",
        "tsConfig": "apps/extension-rr/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/extension-rr/public"
          }
        ],
        "styles": [
          "apps/extension-rr/src/styles.scss"
        ],
        "stylePreprocessorOptions": {
          "sass": {
            "silenceDeprecations": ["import"]
          }
        }
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "20kb",
              "maximumError": "60kb"
            }
          ],
          "outputHashing": "none",
          "fileReplacements": [
            {
              "replace": "apps/portfolio/src/environments/environment.ts",
              "with": "apps/portfolio/src/environments/environment.prod.ts"
            }
          ]
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "extension-rr:build:production"
        },
        "development": {
          "buildTarget": "extension-rr:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "extension-rr:build",
        "staticFilePath": "dist/apps/extension-rr/browser",
        "spa": true
      }
    }
  }
}
